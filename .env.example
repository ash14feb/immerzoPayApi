PORT=3000
# Cashfree — single common place (keys from https://merchant.cashfree.com)
CASHFREE_ENV=sandbox
CASHFREE_CLIENT_ID=your_client_id
CASHFREE_CLIENT_SECRET=your_client_secret
CASHFREE_API_VERSION=2025-01-01
# WhatsApp (Flaxxa WAPI) — token from provider dashboard, never commit real token
WHATSAPP_API_BASE=https://wapi.flaxxa.com/api/v1
WHATSAPP_TOKEN=your_flaxxa_token_here
# MySQL
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=PhotoAIDB
